# This template intentionally cannot start. Replace every REPLACE_* value only
# with values approved by product, security, privacy and the service owner.
AI_PROXY_MODE=production
AI_PROXY_PUBLIC_ORIGIN=REPLACE_APPROVED_HTTPS_ORIGIN
AI_PROXY_PROTOCOL_VERSION=REPLACE_APPROVED_PROTOCOL_VERSION
AI_PROXY_CONSENT_VERSION=REPLACE_APPROVED_INTEGER
AI_PROXY_TOKEN_ISSUER=REPLACE_APPROVED_IDENTITY_ISSUER
AI_PROXY_TOKEN_AUDIENCE=REPLACE_APPROVED_AUDIENCE
AI_PROXY_JWKS_PATH=/run/secrets/ai-proxy/jwks.json
AI_PROXY_MAX_TOKEN_LIFETIME_SECONDS=300
AI_PROXY_TOKEN_CLOCK_SKEW_SECONDS=15
AI_PROXY_RETENTION_POLICY_ID=REPLACE_APPROVED_RETENTION_POLICY_ID
AI_PROXY_NO_TRAIN_POLICY_ID=REPLACE_APPROVED_NO_TRAIN_POLICY_ID
AI_PROXY_PRIVACY_NOTICE_ID=REPLACE_APPROVED_PRIVACY_NOTICE_ID
AI_PROXY_RATE_LIMIT_PER_MINUTE=REPLACE_APPROVED_INTEGER
AI_PROXY_REPLAY_WINDOW_MS=600000
AI_MODEL_GATEWAY_URL=REPLACE_APPROVED_HTTPS_MODEL_GATEWAY
AI_MODEL_AUTH_TOKEN_FILE=/run/secrets/ai-proxy/model-token
AI_MODEL_TIMEOUT_MS=6000
# Set true only behind an approved load balancer/service mesh that enforces HTTPS.
AI_PROXY_EXTERNAL_TLS_TERMINATED=REPLACE_TRUE_OR_FALSE
# Required when TLS is terminated in this process.
AI_PROXY_TLS_CERT_PATH=/run/secrets/ai-proxy/tls.crt
AI_PROXY_TLS_KEY_PATH=/run/secrets/ai-proxy/tls.key
HOST=0.0.0.0
PORT=8080
